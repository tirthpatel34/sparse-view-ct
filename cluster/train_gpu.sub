# Full training run on CHTC's GPU Lab.
#   condor_submit train_gpu.sub
# Set STAGING to your own /staging directory first. Create logs/ before submitting.

STAGING = /staging/<your-path>

container_image = file://$(STAGING)/container.sif

executable  = run_train.sh
arguments   = $(Cluster) $(Process) configs/train.yaml
environment = "STAGING=$(STAGING)"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = code.tar.gz

log    = logs/job_$(Cluster)_$(Process).log
error  = logs/job_$(Cluster)_$(Process).err
output = logs/job_$(Cluster)_$(Process).out

request_gpus = 1
+WantGPULab = true
# GPU Lab limits: short = 12 h, medium = 24 h, long = 7 days. A job past its
# limit is killed without warning; run_train.sh resumes it on resubmission.
+GPUJobLength = "medium"
gpus_minimum_memory = 100000M

request_cpus   = 4
request_memory = 32GB
request_disk   = 60GB

requirements = (HasCHTCStaging == true)
queue 1
