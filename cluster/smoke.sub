# Short smoke test: same job script, a few steps, a separate run directory
# (RUN_TAG) so it never mixes checkpoints with the real run.
#   condor_submit smoke.sub
# Extra arguments after the config are passed straight to the training script.

STAGING = /staging/<your-path>

container_image = file://$(STAGING)/container.sif

executable  = run_train.sh
arguments   = $(Cluster) $(Process) configs/train.yaml --epochs 2 --steps-per-epoch 50
environment = "STAGING=$(STAGING) RUN_TAG=_smoke"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = code.tar.gz

log    = logs/job_$(Cluster)_$(Process).log
error  = logs/job_$(Cluster)_$(Process).err
output = logs/job_$(Cluster)_$(Process).out

request_gpus = 1
+WantGPULab = true
+GPUJobLength = "short"
gpus_minimum_memory = 20000M
gpus_maximum_capability = 9.0

request_cpus   = 4
request_memory = 16GB
request_disk   = 30GB

requirements = (HasCHTCStaging == true)
queue 1
